---
# Keep ansible-lint useful for this repo's playbooks/roles without forcing
# large refactors of deliberate bootstrap/install patterns.

profile: basic
use_default_rules: true

exclude_paths:
  - .cache/

warn_list:
  - experimental

skip_list:
  # Bootstrap/install tasks intentionally use command/shell for vendor install
  # flows, platform checks, and one-shot system utilities.
  - command-instead-of-module
  # Many verification/bootstrap commands are intentionally read-only or use
  # explicit changed_when/failed_when handling elsewhere in the task.
  - no-changed-when
  # Existing roles predate strict ansible-lint role-prefix naming conventions.
  - var-naming
  # Role meta files are intentionally minimal; adding full Galaxy metadata is
  # outside the scope of local lint hygiene for these playbooks.
  - schema[meta]
